  "boundaries": {
    "clock": "time.perf_counter; GC enabled, collect before each repetition",
    "io": "Warm-cache reads, gzip decompression and UTF-8/JSON parsing timed separately; validation and SHA-256 checks outside clocks. Five reads plus an untimed warm-up.",
    "timing": "Preloaded events; direct engine classes; five fresh books and an untimed fresh-book warm-up. No inspection, counters, deepcopy or comparison. Replay discards each returned result; single-sale retains its result until the clock stops. Result creation is included.",
    "total_compute": "Initialization + construction + replay, summed within each repetition. I/O excluded. Summary is median of these sums, not sum of medians.",
    "latency": "Separate instrumented pass; clocks surround each process_event call and result disposal for replay. Sample-list append excluded. No overhead subtraction. Single-sale experiments use five fresh books/samples.",
    "percentiles": "Median uses statistics.median (average middle pair for even n); P95/P99 use nearest rank, sorted[ceil(p*n)-1], without interpolation.",
    "memory": "Separate worker process and separate tracemalloc run per fresh book. Input, imports and warm-up excluded; book construction, setup, engine allocations and transient results included. No saved event-result history. Current bytes measured after GC; peak includes temporary cleanup and instrumentation allocations. Tracemalloc is Python allocation memory, not process RSS. Five repetitions; construction checkpoint included.",
    "diagnostics": "Separate untimed pass; counters after every setup/replay event. Final canonical snapshot and ordered-result digests compare versions. Diagnostic costs are never part of primary timing.",
    "limits": "Per-worker wall timeout and global campaign deadline are enforced by the parent. Compressed/decompressed payload limits checked before parse. Traced-allocation cap checked between memory-run events; an individual event can exceed it before the check. No OS RSS/CPU hard cap.",
    "sale": "Setup uses a fresh identical passive bid book per sale. Construction timed separately. Integer ceil(depth * percent / 100); 10%, 100%, 200%. Throughput counts one sale, not its setup events.",
    "queue_concentration": "Same order count, requested 4 versus 1000 levels. Actual occupied levels are min(order_count, requested_levels).",
    "churn": "An old active head remains while same-price orders are added/cancelled; capture retained storage and memory before final head cancellation and after it. Stream size is 2 * requested_count + 2."
  }
}
